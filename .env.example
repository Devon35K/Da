# Copy this file to .env or .env.local in the project root.
# Vite picks up any VITE_* variables at build time.

# Django backend URL. Defaults to localhost:8000 if unset.
# For phone testing replace with your PC's LAN IP:
#   VITE_API_BASE=http://192.168.1.42:8000
VITE_API_BASE=http://localhost:8000
